# Copy to .env and fill in what you have. Services without a key are reported
# as "not_configured" by GET /api/health rather than failing the build —
# see docs/adr/ADR-009-local-disk-storage-p0.md and SPEC.md §4 P0 exit gate.

# --- Core infra (docker-compose provides these automatically for containers;
#     only needed here if running api/worker outside compose) ---
DATABASE_URL=postgresql+asyncpg://pincite:pincite@localhost:5432/pincite
REDIS_URL=redis://localhost:6379/0
UPLOADS_DIR=./data/uploads
# Comma-separated exact browser origins allowed to call the API. Add the
# Vercel production and preview domains when deploying the web application.
ALLOWED_ORIGINS=http://localhost:3000

# --- Sentry (NFR-OBS-001) ---
SENTRY_DSN_API=
SENTRY_DSN_WORKER=
SENTRY_DSN_WEB=
SENTRY_ENVIRONMENT=development

# --- Sponsor / pipeline services (SPEC.md §3, TRACKS.md) ---
COURTLISTENER_API_TOKEN=
OPENAI_API_KEY=
ELASTIC_CLOUD_ID=
ELASTIC_API_KEY=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
GPTZERO_API_KEY=

# --- Frontend (must be prefixed NEXT_PUBLIC_ to reach the browser — never put
#     secrets here; NFR-SEC-001 keeps all API keys server-side) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SENTRY_DSN=
